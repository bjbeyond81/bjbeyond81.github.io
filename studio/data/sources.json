  "news": {
    "_terms_check": "Before adding any new source, read that publisher's RSS/feed terms of use and confirm they allow listing headlines with a link back (title, source, date, link only). Note the check in the commit message. Aggregators are not allowed; permanent exclusions are in blocklist.json.",
    "_comment": "Publishers' own official RSS/Atom feeds only (no aggregators such as Google News). Stored per item: title, source name, date, link. Nothing else from the feed is kept: no descriptions, snippets or images. 'detection' feeds contribute only items whose title or summary matches detection_keywords; 'ai' feeds are general AI coverage used to fill the list. The summary is read only to filter and is never stored. For general 'ai' feeds an item is tagged 'AI detection' when the title matches detection_keywords or the summary matches strict_keywords.",
    "max_items": 30,
    "max_age_days": 45,
